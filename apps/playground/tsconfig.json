{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    // Mirrors the single alias rule in vite.config.ts: `@rxova/<name>` is
    // `packages/<name>`, so adding an input needs no entry here.
    "paths": {
      "@rxova/*": ["../../packages/*/src/index.ts"]
    }
  },
  "include": ["App.tsx", "main.tsx", "vite.config.ts"]
}
