{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", ".nvmrc"],
  "globalPassThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // NOT .docusaurus/**: it's Docusaurus's regenerable internal cache, tied to
      // the installed theme/plugins. Caching+restoring it across contexts breaks
      // webpack module resolution (stale @theme/Debug* refs). Only build/** (the
      // static site) and dist/** (library builds) are real, portable outputs.
      "outputs": ["dist/**", "build/**"],
      // A library build only reads src + build config. Excluding e2e/tests/demo/
      // docs-adjacent files keeps editing them from busting the build cache
      // (they can't affect dist). $TURBO_DEFAULT$ keeps the normal file set.
      "inputs": [
        "$TURBO_DEFAULT$",
        "!e2e/**",
        "!demo/**",
        "!**/__tests__/**",
        "!**/*.test.*",
        "!**/*.browser.test.*",
        "!**/__screenshots__/**",
        "!README.md",
        "!CHANGELOG.md"
      ],
      "env": ["DOCS_URL", "DOCS_BASE_URL"],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "outputLogs": "new-only"
    },
    "check:exports": {
      "dependsOn": ["build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "pack:smoke": {
      "dependsOn": ["build"],
      "outputs": [],
      // The smoke test logic lives in the shared packages/utils/pack-smoke.mjs,
      // outside each package — include it so editing it invalidates the cache
      // instead of silently replaying an old pass.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/utils/pack-smoke.mjs"],
      "outputLogs": "new-only"
    },
    "size": {
      "dependsOn": ["build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "e2e": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
