{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", ".nvmrc"],
  "globalPassThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // NOT .astro/**: it's Astro's regenerable internal cache. Caching and
      // restoring a tool's own scratch directory across contexts is how you get
      // stale-module resolution failures. Only dist/** — the library builds and
      // the built docs site — is a portable output.
      "outputs": ["dist/**"],
      // A library build only reads src + build config. Excluding e2e/tests/demo/
      // docs-adjacent files keeps editing them from busting the build cache
      // (they can't affect dist). $TURBO_DEFAULT$ keeps the normal file set.
      "inputs": [
        "$TURBO_DEFAULT$",
        "!e2e/**",
        "!demo/**",
        "!**/__tests__/**",
        "!**/*.test.*",
        "!**/*.browser.test.*",
        "!**/__screenshots__/**",
        "!README.md",
        "!CHANGELOG.md"
      ],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "outputLogs": "new-only"
    },
    // These three all inspect a package's build artifacts, so they must never
    // run against a stale or absent dist. Declaring the dependency here rather
    // than per-package means a package added later inherits the guarantee — a
    // missing local turbo.json would otherwise pass silently against old output.
    "check:exports": {
      "dependsOn": ["build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "pack:smoke": {
      "dependsOn": ["build"],
      "outputs": [],
      // Smoke-test logic lives in shared scripts outside each package — include
      // both so editing either invalidates the cache instead of replaying an old pass.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/utils/pack-smoke.ts",
        "$TURBO_ROOT$/packages/utils/codemod-pack-smoke.ts"
      ],
      "outputLogs": "new-only"
    },
    "size": {
      "dependsOn": ["build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    // A root task (`//#`), not a per-package one: the checker reads the root
    // README plus every packages/*/README.md in a single pass from the repo
    // root, so there is nothing to fan out. `inputs` is listed explicitly
    // rather than via $TURBO_DEFAULT$ so the cache is keyed on exactly what the
    // check reads — the authored READMEs and the checker itself. Touching
    // source, tests or the docs site cannot invalidate it, and editing any
    // README (or the script) invalidates it instead of replaying a stale pass.
    "//#check:docs": {
      "outputs": [],
      "inputs": ["README.md", "packages/*/README.md", "packages/utils/check-doc-snippets.ts"],
      "outputLogs": "new-only"
    },
    // A root task (`//#`) for the same reason as check:docs: `pnpm dedupe
    // --check` reads the whole workspace in one pass from the root, so there is
    // nothing to fan out. It is the single most expensive check in the pre-push
    // gate (~23s) and yet a pure function of the dependency graph — the
    // lockfile, the workspace definition, and every manifest that feeds them.
    // Keying the cache on exactly those files means editing source, tests or
    // docs replays it instantly, while any dependency change re-runs it.
    //
    // Deliberately NOT applied to audit:check: that one's result depends on the
    // upstream advisory database, which changes without any file changing here,
    // so caching it locally could replay a pass over a newly-disclosed CVE.
    "//#dedupe:check": {
      "outputs": [],
      "inputs": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "package.json",
        "packages/*/package.json",
        "apps/*/package.json"
      ],
      "outputLogs": "new-only"
    },
    "e2e": {
      "cache": false
    },
    // No `start` task. It was the Docusaurus-era name for the docs dev server,
    // and after the Starlight migration no package declared it — so
    // `turbo run start` matched nothing, printed "No tasks were executed" and
    // exited 0. The root `docs:dev` script pointed at it, which meant
    // `pnpm run docs` silently did nothing instead of starting Astro. Both are
    // gone; `dev` below is the one dev-server task.
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
