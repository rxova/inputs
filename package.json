{
  "name": "rxova",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The rxova monorepo: a suite of headless, accessible React input components.",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "format": "prettier --write . --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "format:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "size": "turbo run size",
    "check:exports": "turbo run check:exports --concurrency=1",
    "pack:smoke": "turbo run pack:smoke --concurrency=1",
    "audit:check": "pnpm audit --audit-level=high",
    "dedupe:check": "pnpm dedupe --check",
    "dev": "turbo run dev --filter=@rxova/playground",
    "playground:build": "turbo run build --filter=@rxova/playground",
    "docs": "turbo run start --filter=@rxova/docs",
    "docs:build": "turbo run build --filter=@rxova/docs",
    "e2e": "turbo run e2e",
    "e2e:install": "playwright install --with-deps chromium firefox webkit",
    "release": "turbo run build && changeset publish",
    "prepare": "husky",
    "check:docs": "node packages/utils/check-doc-snippets.mjs",
    "check:browsers": "node packages/utils/check-browsers.mjs",
    "verify": "node packages/utils/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "axe-core": "^4.12.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "turbo": "^2.5.8",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/react-inputs.git"
  },
  "bugs": {
    "url": "https://github.com/rxova/react-inputs/issues"
  },
  "homepage": "https://github.com/rxova/react-inputs#readme"
}
