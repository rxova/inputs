{
  "name": "@rxova/codemod",
  "version": "0.1.0",
  "type": "module",
  "description": "jscodeshift codemods for migrating onto the rxova input suite. Run `npx @rxova/codemod <transform> <path>`.",
  "keywords": [
    "codemod",
    "jscodeshift",
    "migration",
    "rxova",
    "input-otp",
    "react-otp-input"
  ],
  "license": "MIT",
  "bin": {
    "rxova-codemod": "./dist/bin.cjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./transforms/*": {
      "types": "./dist/transforms/*.d.cts",
      "default": "./dist/transforms/*.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "jscodeshift": "^17.1.2"
  },
  "devDependencies": {
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^26.1.1",
    "tsdown": "^0.22.13",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/inputs.git",
    "directory": "packages/codemod"
  },
  "homepage": "https://github.com/rxova/inputs/tree/main/packages/codemod#readme",
  "bugs": {
    "url": "https://github.com/rxova/inputs/issues"
  }
}
