{
  "name": "@rxova/codemod-otp",
  "version": "0.1.0",
  "type": "module",
  "description": "jscodeshift codemod: migrate input-otp to @rxova/react-otp-input.",
  "keywords": [
    "codemod",
    "jscodeshift",
    "input-otp",
    "react-otp-input",
    "migration"
  ],
  "license": "MIT",
  "bin": {
    "rxova-codemod-otp": "./dist/bin.cjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./transform": {
      "types": "./dist/transform.d.cts",
      "default": "./dist/transform.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "jscodeshift": "^17.1.2"
  },
  "devDependencies": {
    "@types/jscodeshift": "^0.12.0",
    "@types/node": "^26.1.1",
    "tsdown": "^0.22.13",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/inputs.git",
    "directory": "packages/codemod-otp"
  },
  "homepage": "https://rxova.github.io/inputs/otp/codemod",
  "bugs": {
    "url": "https://github.com/rxova/inputs/issues"
  }
}
